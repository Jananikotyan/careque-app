{
  "info": {
    "name": "CareQueue API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"patient\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Register Doctor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dr. Smith\",\n  \"email\": \"smith@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"doctor\",\n  \"specialty\": \"Cardiologist\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"patient\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Book Appointment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctor_id\": \"<INSERT_DOCTOR_UUID>\",\n  \"appointment_date\": \"2026-08-01\",\n  \"start_time\": \"09:00:00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/appointments",
              "host": ["{{base_url}}"],
              "path": ["api", "appointments"]
            }
          }
        },
        {
          "name": "Update Appointment Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/appointments/<INSERT_APPOINTMENT_UUID>/status",
              "host": ["{{base_url}}"],
              "path": ["api", "appointments", "<INSERT_APPOINTMENT_UUID>", "status"]
            }
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/appointments/<INSERT_APPOINTMENT_UUID>",
              "host": ["{{base_url}}"],
              "path": ["api", "appointments", "<INSERT_APPOINTMENT_UUID>"]
            }
          }
        }
      ]
    },
    {
      "name": "Doctors",
      "item": [
        {
          "name": "Get Doctor Queue",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/<INSERT_DOCTOR_UUID>/queue",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "<INSERT_DOCTOR_UUID>", "queue"]
            }
          }
        },
        {
          "name": "Call Next Patient",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/<INSERT_DOCTOR_UUID>/next",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "<INSERT_DOCTOR_UUID>", "next"]
            }
          }
        },
        {
          "name": "Get Doctor Slots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/doctors/<INSERT_DOCTOR_UUID>/slots?date=2026-08-01",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "<INSERT_DOCTOR_UUID>", "slots"],
              "query": [
                { "key": "date", "value": "2026-08-01" }
              ]
            }
          }
        },
        {
          "name": "Get AI Recommendations",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/doctors/<INSERT_DOCTOR_UUID>/recommendations",
              "host": ["{{base_url}}"],
              "path": ["api", "doctors", "<INSERT_DOCTOR_UUID>", "recommendations"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "jwt_token",
      "value": "your_jwt_token_here"
    }
  ]
}
